{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iconette",
  "version": "0.4.2",
  "identifier": "io.github.hry1729.iconette",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Icônette",
        "width": 760,
        "height": 520,
        "minWidth": 600,
        "minHeight": 420,
        "center": true,
        "resizable": true
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Icônette 速取",
        "width": 560,
        "height": 248,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENkM5NTdDQjRCOUY2NzYKUldSMjlybTBmSlZzM2VOZlRFZTZCb3IzU2VtYTZLVTl3bXBRWXU5N3BLMDBiYk0veWtlOHgyVEMK",
      "endpoints": [
        "https://github.com/Hry1729/icones-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Icônette: find icons & UI components",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "小小的 Icônes：轻量的图标与 UI 组件查找工具。",
    "copyright": "© 2026 Hry1729 · based on Icônes by Anthony Fu",
    "publisher": "Hry1729"
  }
}
