{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Icônette",
        "width": 760,
        "height": 520,
        "minWidth": 600,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Icônette 速取",
        "width": 560,
        "height": 248,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "focus": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}
